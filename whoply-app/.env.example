# Whoply — shopkeeper & wholesaler PWA (:7200 in dev)
# Copy to `.env.local` (or run `node setup.mjs` from the repo root).
#
# Base URL of the Whoply API, INCLUDING the /api path.
# These NEXT_PUBLIC_* values are baked in at build time — rebuild after changing.
#
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:7000/api
# Testing from a phone on the same Wi-Fi? Use your PC's LAN IP, not localhost:
#   NEXT_PUBLIC_API_URL=http://192.168.1.20:7000/api
# Production:
#   NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
