# ── Whoply API — environment ───────────────────────────────────────────────
# Copy to `.env` and adjust. NEVER commit the real `.env`.
#   Easiest: run `node setup.mjs` from the repo root — it writes this file for
#   you with a freshly generated JWT_SECRET.
#
# The values below are the LOCAL DEVELOPMENT defaults and work as-is.
# Production overrides are noted per line.

# Server
NODE_ENV=development                # development | production | test
PORT=7000

# Database
# Local: install MongoDB, or run `docker compose up -d` from the repo root.
# Production: use a managed URI (MongoDB Atlas).
MONGODB_URI=mongodb://localhost:27017/whoply

# Auth — MUST be a long random string (min 32 chars) or the API refuses to boot.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# App identity + front-end URLs.
# In production these form the CORS allowlist, so they MUST be your real domains
# (e.g. https://app.yourdomain.com). In development CORS is open, so localhost is fine.
APP_NAME=Whoply
APP_URL=http://localhost:7200        # shopkeeper/wholesaler PWA
ADMIN_URL=http://localhost:7300      # admin panel
FRONT_URL=http://localhost:7100      # marketing/landing site

# Optional extra CORS origins (comma-separated), added on top of the URLs above.
# Useful for LAN testing from a phone, e.g. http://192.168.1.20:7200
# CORS_ORIGINS=https://staging.yourdomain.com

# Behind nginx / a load balancer? Set how many proxies sit in front of the API
# (usually 1) so wrong-password limits count each visitor's own address.
# TRUST_PROXY=1

# Limits (SECURITY.md). Most requests one network address may make in a minute (0 = no limit);
# connections kept open to MongoDB; the longest one database query may run.
# RATE_LIMIT_PER_MIN=1500
# DB_POOL_SIZE=20
# DB_QUERY_TIMEOUT_MS=30000

# Daily database backup (see README → Backups). Folder relative to this API folder;
# best on another drive or a synced folder (e.g. D:/whoply-backups). "off" = no automatic backup.
# BACKUP_DIR=../backups
# BACKUP_KEEP=7

# Who may sign in (see src/config/env.ts). Self sign-up is closed: a platform admin creates
# each business. OTP sign-in sends the code on WhatsApp: it turns on by itself once WhatsApp
# is switched on in the admin panel (Settings → WhatsApp). OTP_LOGIN=off forbids it.
# ALLOW_SIGNUP=false
# OTP_LOGIN=auto

# Phone notifications (Web Push). Run `npm run push:keys` once and paste its three lines here.
# Leave empty to keep phone notifications off. Never change the keys once people use them.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@your-domain.com

# Image uploads (optional — Cloudinary). Leave blank to disable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# NOTE: the fixed test OTP 123456 (also returned in the API reply) exists only in dev mode:
# NODE_ENV is not production AND the database is on this machine (src/utils/devMode.ts).
# Anywhere else the code is random, is never returned, and goes out on WhatsApp
# (src/services/whatsapp.service.ts; set up on the admin Settings page).
