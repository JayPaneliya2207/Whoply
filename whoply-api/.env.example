# ── Whoply API — environment ───────────────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# Server
NODE_ENV=production                 # development | production | test
PORT=7000

# Database — use a managed MongoDB URI in production (e.g. MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/whoply

# Auth — MUST be a long random string (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# App identity + front-end URLs (used for the CORS allowlist in production)
APP_NAME=Whoply
APP_URL=https://app.yourdomain.com          # shopkeeper/wholesaler PWA (:7200 in dev)
ADMIN_URL=https://admin.yourdomain.com       # admin panel (:7300 in dev)
FRONT_URL=https://www.yourdomain.com         # marketing/landing site (:7100 in dev)

# Optional extra CORS origins (comma-separated), added on top of the URLs above
# CORS_ORIGINS=https://staging.yourdomain.com

# Image uploads (optional — Cloudinary). Leave blank to disable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# NOTE: OTP is a real random 6-digit code in production (wire your SMS provider
# in src/controllers/auth.controller.ts -> requestOtp). In development it is a
# fixed 123456 and returned in the API response for easy manual testing.
