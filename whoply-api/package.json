{
    "name": "whoply-api",
    "version": "1.0.0",
    "description": "Whoply - Retail & Wholesale Business Management Platform API",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && tsc-alias",
        "start": "node dist/server.js",
        "seed": "tsx src/seeds/seed.ts",
        "seed:reset": "tsx src/seeds/reset.ts",
        "db:clear": "tsx src/seeds/reset.ts",
        "migrate": "tsx src/seeds/migrate.ts",
        "migrate:prod": "node dist/seeds/migrate.js",
        "backup": "tsx src/seeds/backup.ts",
        "backup:prod": "node dist/seeds/backup.js",
        "restore": "tsx src/seeds/restore.ts",
        "restore:prod": "node dist/seeds/restore.js",
        "setup": "tsx src/seeds/setup.ts",
        "setup:prod": "node dist/seeds/setup.js",
        "test:e2e": "node tests/e2e.mjs",
        "test:edge": "node tests/edge.mjs",
        "test:explain": "node tests/explain.mjs",
        "test:roles": "node tests/roles.mjs",
        "test:customers": "node tests/customers.mjs",
        "test:money": "node tests/money.mjs",
        "test:stock": "node tests/stock-orders.mjs",
        "test:sales": "node tests/sales-team.mjs",
        "test:dates": "tsx tests/ist.ts",
        "test:wsgst": "node tests/wholesale-gst.mjs",
        "test:gstrows": "tsx tests/gst-rows.ts",
        "test:login": "node tests/login-limits.mjs",
        "test:backup": "tsx tests/backup.ts",
        "test:cron": "tsx tests/cron-times.ts",
        "test:purchases": "node tests/purchases.mjs",
        "test:quotes": "node tests/quotes.mjs",
        "test:admin": "node tests/admin.mjs",
        "test:round2": "node tests/round2.mjs",
        "test:purchasegst": "node tests/purchase-gst.mjs",
        "test:subscription": "node tests/subscription.mjs",
        "test:all": "npm run seed:reset && npm run test:e2e && npm run seed:reset && npm run test:edge && npm run seed:reset && npm run test:roles && npm run seed:reset && npm run test:customers && npm run seed:reset && npm run test:money && npm run seed:reset && npm run test:stock && npm run seed:reset && npm run test:sales && npm run seed:reset && npm run test:wsgst && npm run seed:reset && npm run test:login && npm run seed:reset && npm run test:purchases && npm run seed:reset && npm run test:quotes && npm run seed:reset && npm run test:admin && npm run seed:reset && npm run test:round2 && npm run seed:reset && npm run test:purchasegst && npm run seed:reset && npm run test:subscription && npm run test:dates && npm run test:gstrows && npm run test:backup && npm run test:cron",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "whoply",
        "retail",
        "wholesale",
        "pos",
        "inventory",
        "express",
        "typescript",
        "mongodb"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^5.2.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.0.2",
        "node-cron": "^4.2.1",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.28.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.19.10",
        "@types/node-cron": "^3.0.11",
        "eslint": "^9.39.2",
        "prettier": "^3.7.4",
        "tsc-alias": "^1.8.16",
        "tslib": "^2.6.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.34.1"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
