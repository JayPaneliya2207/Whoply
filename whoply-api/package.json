{
    "name": "whoply-api",
    "version": "1.0.0",
    "description": "Whoply - Retail & Wholesale Business Management Platform API",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/server.js",
        "seed": "tsx src/seeds/seed.ts",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "whoply",
        "retail",
        "wholesale",
        "pos",
        "inventory",
        "express",
        "typescript",
        "mongodb"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cloudinary": "^2.5.1",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^5.2.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.0.2",
        "multer": "^2.0.0",
        "node-cron": "^4.2.1",
        "sharp": "^0.34.5",
        "uuid": "^13.0.0",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.28.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.19.10",
        "@types/node-cron": "^3.0.11",
        "eslint": "^9.39.2",
        "prettier": "^3.7.4",
        "tsc-alias": "^1.8.16",
        "tslib": "^2.6.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.34.1"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
