# Whoply live settings. Copy to deploy/.env on the server and fill in.
# deploy/.env holds secrets — it is git-ignored; never commit or share it.

# Your domain, without https:// or www — e.g. whoply.in
# The sites will be: whoply.in, app.whoply.in, admin.whoply.in, api.whoply.in
DOMAIN=yourdomain.com

# MongoDB Atlas connection string (Atlas → Connect → Drivers), with the database name
# /whoply before the "?". Example:
# mongodb+srv://whoply:PASSWORD@cluster0.abcde.mongodb.net/whoply?retryWrites=true&w=majority
MONGODB_URI=

# A long random secret that signs logins. Make one on the server with:
#   openssl rand -hex 48
# Changing it later signs everyone out.
JWT_SECRET=

# How many daily backups to keep in deploy/backups (default 14).
# BACKUP_KEEP=14

# Phone notifications (optional). Make the keys once, on the server:
#   docker compose run --rm api npm run push:keys:prod
# paste the three lines below, then run ./deploy.sh again. Leave empty to keep them off.
# Never change the keys later: every device would have to turn notifications on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# OTP sign-in. Leave it off until an SMS provider is connected; people sign in with the
# password you set for them in the admin panel.
# OTP_LOGIN=on
